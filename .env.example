# Sin valores reales. En desarrollo, `npm run migrate` crea .env con los secretos que falten.
# En producción (NODE_ENV=production) todos deben venir del entorno del hosting: si falta uno, el arranque falla.

# Propietario de la base: solo migraciones y semilla.
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5433/codes
# Contraseñas de los roles de la aplicación (las migraciones crean los roles SIN contraseña; migrate las fija).
DB_APP_RW_PASSWORD=
DB_ADMIN_RO_PASSWORD=
DB_ADMIN_RW_PASSWORD=
# Opcional: URL completas por rol si no comparten host/base con DATABASE_URL.
# APP_DATABASE_URL=
# ADMIN_DATABASE_URL=
# ADMIN_RW_DATABASE_URL=

# Clave de cifrado del secreto TOTP: 32 bytes en base64 (p. ej. `openssl rand -base64 32`). No la pierdas: sin ella hay que re-enrolar el TOTP.
TOTP_ENC_KEY=

RESOLVER_HOST=localhost:3000
PORT=3000
NODE_ENV=development
# 1 si hay un proxy TLS delante (IP y host reales desde X-Forwarded-*).
TRUST_PROXY=

# Contraseñas de los usuarios de la semilla (si faltan, se generan en .dev-credentials.txt).
SEED_ADMIN_PASSWORD=
SEED_POS_PASSWORD=
