// Scan-bar en Cloudflare, plan gratuito: un Worker (cloudflare/src/index.ts) que da la dirección fija
// https://scan-bar.<tu-cuenta>.workers.dev y pasa cada petición al servidor que corre en tu PC (panel: npm run servidor),
// a través de un túnel gratuito de Cloudflare. Va en la raíz para el despliegue por defecto (Import a repository).
// Único secreto: SCANBAR_PROXY_KEY (la llave que muestra el panel). Ver docs/DESPLIEGUE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scan-bar",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  // Dirección actual del servidor (la del túnel): Durable Object con almacenamiento SQLite, incluido en el plan gratuito.
  "durable_objects": {
    "bindings": [{ "name": "ORIGEN", "class_name": "ScanbarOrigin" }]
  },
  // v1 creó la clase del contenedor de pago (Cloudflare Containers); v2 la convierte en el registro de la dirección.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScanbarContainer"] },
    { "tag": "v2", "renamed_classes": [{ "from": "ScanbarContainer", "to": "ScanbarOrigin" }] }
  ],
  "observability": { "enabled": true }
}
